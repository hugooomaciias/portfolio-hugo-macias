---
/**
 * Projects Component
 *
 * Purpose: Displays the projects timeline. Iterates over a predefined
 * set of projects to render a responsive timeline with icons, dates, bullet points, and 
 * technology tags for each project.
 */

import { Icon } from "astro-icon/components";

/**
 * Data structure defining the main project entry.
 * Maps directly to i18n translation keys for internationalization.
 */
const mainProjectTechnologies = ["React", "JavaScript", "JAVA", "Spring Boot", "Spring AI", "MySQL", "Docker"];

/**
 * Data structure defining the secondary project entries.
 * Maps directly to i18n translation keys for internationalization.
 */
const secondaryProjects = [
    {
        company: "Autos Miari",
        title: "projects.p1.title",
        desc: "projects.p1.desc",
        img: "../../public/projects/AUTOS_MIARI.png",
        icon: "tabler:world",
        tags: ["React", "JavaScript", "HTML", "Tailwind CSS"],
        demo: "https://auto-miari.vercel.app/",
        github: "https://github.com/hugooomaciias/Auto-Miari",
    },
    {
        company: "CloudCare",
        title: "projects.p2.title",
        desc: "projects.p2.desc",
        img: "../../public/projects/CLOUDCARE.png",
        icon: "tabler:stack-2",
        tags: ["Angular", "TypeScript", "Python", "AWS", "Java", "Spring Boot"],
        github: "https://github.com/fog-3/CloudCare",
    },
    {
        class: "-rotate-90",
        title: "projects.p3.title",
        desc: "projects.p3.desc",
        img: "../../public/projects/CPM.png",
        icon: "tabler:layout-kanban",
        tags: ["Python", "NetworkX", "Streamlit", "LaTeX"],
        demo: "https://cpm-algorithm.streamlit.app/",
        github: "https://github.com/hugooomaciias/algorithm_cpm",
    },
    {
        title: "projects.p4.title",
        desc: "projects.p4.desc",
        imgDark: "../../public/projects/MYFACE_DARK.png",
        imgLight: "../../public/projects/MYFACE_LIGHT.png",
        icon: "tabler:user",
        tags: ["HTML", "CSS"],
        demo: "https://hugooomaciias.github.io/my_face/",
        github: "https://github.com/hugooomaciias/my_face",
    },
];
---

<!-- ==================== PROJECTS ==================== -->
<section id="projects" class="relative py-24 md:py-32">
    <div class="max-w-7xl mx-auto px-6 space-y-6">
        <!-- Section Header -->
        <div class="text-center mb-12">
            <span class="reveal text-primary-400 text-xs font-mono uppercase tracking-widest" data-i18n="projects.title"
            ></span>
            <h2
                class="reveal delay-100 text-3xl md:text-4xl font-semibold tracking-tight gradient-text mt-3"
                data-i18n="projects.heading"
            >
            </h2>
            <p
                class="reveal delay-200 text-secondary-400 font-light mt-4 max-w-xl mx-auto"
                data-i18n="projects.subtitle"
            >
            </p>
        </div>

        <div
        class="reveal flex flex-col sm:flex-row card-hover bg-primary-100/30 dark:bg-primary-950/50 border border-primary-200/60 dark:border-primary-600/40 rounded-3xl overflow-hidden shadow-sm hover:shadow-md transition-shadow"
        >
            
            <div
                class="w-full lg:w-1/2 relative bg-primary-50/50 dark:bg-primary-900/10 flex items-center justify-center overflow-hidden"
            >
                <div class="relative w-full rounded-3xl overflow-hidden z-10">
                    <div class="bg-primary-800 px-3 sm:px-4 py-2.5 flex items-center gap-2">
                        <div class="w-2.5 h-2.5 rounded-full bg-[#ff5f56] shadow-sm"></div>
                        <div class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e] shadow-sm"></div>
                        <div class="w-2.5 h-2.5 rounded-full bg-[#27c93f] shadow-sm"></div>
                    </div>

                    <img
                        src="../../public/projects/TIKAL.png"
                        alt="Dashboard del TFG"
                        class="w-full h-auto object-cover bg-white"
                    />
                </div>
            </div>

            <!-- Main Project Entry Container -->
            <div class="w-full lg:w-1/2 pl-10 pr-8 py-4 flex flex-col justify-center relative z-10">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3 mb-4">
                        <div
                            class="w-10 h-10 rounded-xl bg-primary-100 dark:bg-primary-800 flex items-center justify-center"
                        >
                            <Icon name="tabler:school-filled" class="w-5 h-5 text-primary-600 dark:text-primary-300" />
                        </div>
                        <h3
                            class="text-2xl md:text-3xl font-bold text-secondary-900 dark:text-secondary tracking-tight"
                        >
                            Tikal
                        </h3>
                    </div>

                    <div
                        class="inline-flex items-center gap-2 text-xs font-semibold text-amber-600 dark:text-amber-400 bg-amber-500/10 border border-amber-500 dark:border-amber-500/20 px-3 py-1.5 rounded-full w-max mb-6"
                    >
                        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                        <span data-i18n="projects.inDevelopment"></span>
                    </div>
                </div>

                <p
                    class="text-secondary-600 dark:text-secondary-400 text-base font-light leading-relaxed mb-4"
                    data-i18n="projects.main.desc"
                >
                </p>

                <div class="flex flex-wrap gap-2 mb-6">
                    {
                        mainProjectTechnologies.map((technologie) => (
                            <span class="text-[11px] font-semibold uppercase tracking-wide text-primary-700 dark:text-primary-400 bg-primary-600/10 dark:bg-primary-500/10 border border-primary-600/20 dark:border-primary-500/20 px-2 py-1.5 rounded-lg">
                                {technologie}
                            </span>
                        ))
                    }
                </div>

                <div class="flex items-center gap-4">
                    <a
                        href="https://github.com/hugooomaciias/Tikal"
                        target="_blank" rel="noopener noreferrer"
                        class="btn-primary text-secondary text-sm font-semibold px-6 py-2.5 rounded-xl inline-flex items-center gap-2"
                    >
                        <Icon name="tabler:brand-github-filled" class="w-5 h-5" />
                        <span data-i18n="projects.btn.github"></span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Secondary Projects Entries Container -->
        <div class="grid md:grid-cols-2 gap-6">
            {
                secondaryProjects.map((project, index) => {
                    const delayClass = index === 0 ? "" : `delay-${index * 100}`;

                    return (
                        <div
                            class={`reveal ${delayClass} group flex flex-col card-hover bg-primary-100/30 dark:bg-primary-950/50 border border-primary-200/60 dark:border-primary-600/40 rounded-3xl overflow-hidden shadow-sm hover:shadow-md transition-shadow`}
                        >
                            <div class="relative h-48 overflow-hidden">
                                {project.imgDark && project.imgLight ? (
                                    <>
                                        {/* Image Light Theme */}
                                        <img
                                            src={project.imgLight || project.img}
                                            alt={project.title}
                                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 block dark:hidden"
                                        />

                                        {/* Image Dark Theme */}
                                        <img
                                            src={project.imgDark || project.img}
                                            alt={project.title}
                                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 hidden dark:block"
                                        />
                                    </>
                                ) : (
                                    <img
                                        src={project.img || project.imgLight}
                                        alt={project.title}
                                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                                    />
                                )}

                                <div class="project-img-overlay absolute inset-0 bg-gradient-to-t from-primary-50 dark:from-primary to-transparent opacity-50 transition-opacity duration-500 group-hover:opacity-0" />

                                {project.company && (
                                    <div class="absolute top-4 left-4 z-10">
                                        <span class="inline-flex items-center px-3 py-1.5 text-purple-600 bg-purple-200 border border-purple-600/50 backdrop-blur-sm rounded-full text-[10px] font-bold tracking-wider uppercase shadow-sm">
                                            {project.company}
                                        </span>
                                    </div>
                                )}
                            </div>

                            <div class="flex flex-1 flex-col items-start justify-between p-6 sm:p-8">
                                <div>
                                    <div class="flex items-center gap-3 mb-3">
                                        <div
                                            class="w-8 h-8 rounded-lg bg-primary-100 dark:bg-primary-800 flex items-center justify-center"
                                        >
                                            <Icon name={project.icon} class={`w-5 h-5 text-primary-600 dark:text-primary-300 ${project.class}`} />
                                        </div>

                                        <h3 class="text-lg font-medium text-secondary-800 dark:text-secondary tracking-tight" data-i18n={project.title}></h3>
                                    </div>

                                    {/* Project Description */}
                                    <p class="text-secondary-500 dark:text-secondary-400 text-sm font-light leading-relaxed mb-4" data-i18n={project.desc}></p>

                                    {/* Project Tags */}
                                    <div class="flex flex-wrap gap-2 mb-6">
                                        {project.tags.map((tag) => (
                                            <span class="text-[10px] font-medium uppercase tracking-wider text-secondary-600 dark:text-secondary-400 bg-secondary-200/50 dark:bg-secondary-800/70 border border-secondary-400/50 dark:border-secondary-500/40 px-2 py-1.5 rounded-lg">
                                                {tag}
                                            </span>
                                        ))}
                                    </div>
                                </div>

                                {/* CTA Buttons */}
                                <div class="flex items-center gap-3 mt-auto">
                                    {project.demo && (
                                        <a
                                            href={project.demo}
                                            target="_blank" rel="noopener noreferrer"
                                            class="btn-primary text-secondary text-xs px-4 py-2 rounded-full transition-all duration-300 inline-flex items-center gap-1.5"
                                        >
                                            <Icon name="tabler:external-link" class="w-4 h-4" />
                                            <span data-i18n="projects.btn.demo"></span>
                                        </a>
                                    )}

                                    <a
                                        href={project.github}
                                        target="_blank" rel="noopener noreferrer"
                                        class="text-xs font-medium text-primary-400 bg-primary-500/10 hover:bg-primary-500/20 border border-primary-500/20 hover:border-primary-500/30 px-4 py-2 rounded-full transition-all duration-300 inline-flex items-center gap-1.5"
                                    >
                                        <Icon name="tabler:brand-github" class="w-4 h-4" />
                                        <span data-i18n="projects.btn.github"></span>
                                    </a>

                                </div>
                            </div>
                        </div>
                    );
                })
            }
        </div>
    </div>
</section>
