---
/**
 * Contact Component
 *
 * Purpose: Displays the contact form and handles submission.
 */

import { Icon } from "astro-icon/components";
---

<!-- ==================== CONTACT ==================== -->
<section id="contact" class="relative py-24 md:py-32">
    <div class="max-w-3xl mx-auto px-6">
        <!-- Section header -->
        <div class="text-center mb-12">
            <span class="reveal text-primary-400 text-xs font-mono uppercase tracking-widest" data-i18n="contact.title"></span>
            <h2 class="reveal delay-100 text-3xl md:text-4xl font-semibold tracking-tight gradient-text mt-3" data-i18n="contact.heading"></h2>
            <p class="reveal delay-200 text-slate-400 font-light mt-4 max-w-lg mx-auto" data-i18n="contact.subtitle"></p>
        </div>

        <!-- Contact Form -->
        <div class="reveal delay-200">
            <form
                id="contactForm"
                class="card-hover bg-white/80 dark:bg-[#0f172a]/60 border border-slate-200 dark:border-white/10 rounded-2xl p-6 md:p-10 space-y-6"
            >
                <div class="grid md:grid-cols-2 gap-6">
                    <!-- Name Field -->
                    <div>
                        <label class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2 block" data-i18n="contact.form.name"></label>
                        <input
                            type="text"
                            name="name"
                            data-i18n-placeholder="contact.form.name.placeholder"
                            required
                            class="w-full bg-slate-50 dark:bg-white/5 border border-slate-200 dark:border-white/10 focus:border-primary-500/50 dark:focus:border-primary-500/50 focus:bg-slate-100 dark:focus:bg-white/[0.08] text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-600 text-sm px-4 py-3 rounded-xl outline-none transition-all duration-300"
                        />
                    </div>

                    <!-- Email Field -->
                    <div>
                        <label class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2 block" data-i18n="contact.form.email"></label>
                        <input
                            type="email"
                            name="email"
                            data-i18n-placeholder="contact.form.email.placeholder"
                            required
                            class="w-full bg-slate-50 dark:bg-white/5 border border-slate-200 dark:border-white/10 focus:border-primary-500/50 dark:focus:border-primary-500/50 focus:bg-slate-100 dark:focus:bg-white/[0.08] text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-600 text-sm px-4 py-3 rounded-xl outline-none transition-all duration-300"
                        />
                    </div>
                </div>

                <!-- Subject Field -->
                <div>
                    <label class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2 block" data-i18n="contact.form.subject"></label>
                    <input
                        type="text"
                        name="subject"
                        data-i18n-placeholder="contact.form.subject.placeholder"
                        required
                        class="w-full bg-slate-50 dark:bg-white/5 border border-slate-200 dark:border-white/10 focus:border-primary-500/50 dark:focus:border-primary-500/50 focus:bg-slate-100 dark:focus:bg-white/[0.08] text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-600 text-sm px-4 py-3 rounded-xl outline-none transition-all duration-300"
                    />
                </div>

                <!-- Message Field -->
                <div>
                    <label class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2 block" data-i18n="contact.form.message"></label>
                    <textarea
                        name="message"
                        rows="5"
                        data-i18n-placeholder="contact.form.message.placeholder"
                        required
                        class="w-full bg-slate-50 dark:bg-white/5 border border-slate-200 dark:border-white/10 focus:border-primary-500/50 dark:focus:border-primary-500/50 focus:bg-slate-100 dark:focus:bg-white/[0.08] text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-600 text-sm px-4 py-3 rounded-xl outline-none transition-all duration-300 resize-none"
                    ></textarea>
                </div>

                <!-- Send Button -->
                <div class="flex flex-col sm:flex-row items-center gap-4">
                    <button
                        type="submit"
                        class="btn-primary text-white text-sm font-semibold px-8 py-3.5 rounded-xl inline-flex items-center gap-2 w-full sm:w-auto justify-center"
                    >
                        <span data-i18n="contact.form.send"></span>
                        <Icon
                            name="tabler:send"
                            class="w-5 h-5 text-primary-50 dark:text-primary-50"
                        />
                    </button>
                    <span class="text-slate-600 dark:text-slate-400 text-xs" data-i18n="contact.form.or"></span>
                    <a
                        href="mailto:h.mac-04@hotmail.com"
                        class="text-primary-400 hover:text-primary-300 text-xs font-medium transition-colors"
                        >h.mac-04@hotmail.com</a
                    >
                </div>
            </form>
        </div>
    </div>
</section>

<!-- Toast Notification -->
<div
    id="toast"
    class="toast fixed bottom-6 right-6 z-[100] bg-white dark:bg-primary-950 border border-slate-200 dark:border-primary-500/30 rounded-xl p-4 shadow-2xl flex items-start gap-3 max-w-sm pointer-events-none"
>
    <div class="w-8 h-8 rounded-lg bg-primary-500/20 flex items-center justify-center shrink-0">
        <Icon
            name="tabler:circle-check"
            class="w-5 h-5 text-primary-400"
        />
    </div>
    <div>
        <h4 class="text-slate-900 dark:text-white text-sm font-medium mb-1" data-i18n="contact.toast.title"></h4>
        <p class="text-slate-600 dark:text-slate-400 text-xs font-light leading-relaxed" data-i18n="contact.toast.desc"></p>
    </div>
</div>

<script>
    const contactForm = document.getElementById("contactForm") as HTMLFormElement;
    const toast = document.getElementById("toast");
    const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement;

    contactForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        
        if(submitBtn) submitBtn.disabled = true;

        const formData = new FormData(contactForm);

        try {
            const response = await fetch('https://formspree.io/f/xblgyrdp', {
                method: 'POST',
                body: formData,
                headers: {
                    'Accept': 'application/json'
                }
            });

            if (response.ok) {
                toast?.classList.add("show");

                setTimeout(() => {
                    toast?.classList.remove("show");
                }, 3000);

                contactForm.reset();
            } else {
                alert("Hubo un error al enviar el mensaje. Por favor, revisa los campos.");
            }
        } catch (error) {
            alert("Error de conexión. Inténtalo de nuevo más tarde.");
        } finally {
            if(submitBtn) submitBtn.disabled = false;
        }
    });
</script>
